# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
# Optional: MAX messenger bot token
# MAX_BOT_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5433/founder_mode
# Optional: separate DB for tests (event-store, services). If unset, uses DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/founder_mode_test

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini-2025-08-07

# Optional: override config
# NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Metrics (Prometheus)
# METRICS_PORT=9090

# Alerts: Telegram chat ID to receive service error notifications (optional)
ALERT_CHAT_ID=457051957

# Alerts: MAX user_id to receive service error notifications (optional)
# MAX_ALERT_USER_ID=
