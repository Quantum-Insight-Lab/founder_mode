# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
# Optional: MAX messenger bot token
# MAX_BOT_TOKEN=

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5433/founder_mode
# Optional: separate DB for tests (event-store, services). If unset, uses DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/founder_mode_test

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini-2025-08-07
# Опционально: для GPT‑5 см. https://platform.openai.com/docs/guides/reasoning
# Верхняя граница выходных токенов (включая reasoning). По умолчанию: 4096 для прочих моделей, 16384 для gpt-5*.
# OPENAI_MAX_COMPLETION_TOKENS=16384
# Для полной gpt-5 (не mini/nano): low | medium | high; пусто = low; none — не передавать параметр
# OPENAI_REASONING_EFFORT=low

# Optional: override config
# NODE_ENV=development

# Logging
LOG_LEVEL=debug

# Metrics (Prometheus)
# METRICS_PORT=9090

# Alerts: Telegram chat ID — ошибки бота и итог npm run notify-resolved (нужен BOT_TOKEN)
# ALERT_CHAT_ID=

# Alerts: MAX user_id — то же (нужен MAX_BOT_TOKEN)
# MAX_ALERT_USER_ID=

# Сообщение пользователю после исправления сервисной ошибки (скрипт npm run notify-resolved)
# RESOLVED_INCIDENT_MESSAGE=<b>Готово.</b> Мы починили сбой — попробуй ещё раз.
