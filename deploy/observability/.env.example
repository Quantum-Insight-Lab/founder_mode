# Host ports (avoid clashing with bot METRICS_PORT=9090)
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3000

# Grafana first login (change after first login)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: public URL if Grafana is behind reverse proxy
# GRAFANA_ROOT_URL=https://grafana.example.com
