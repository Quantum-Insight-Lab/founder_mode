{
  "name": "founder-mode",
  "version": "0.1.0",
  "description": "Founder Mode — declaration, фиксации и weekly report для фаундеров",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/llm/prompts dist/llm/",
    "playwright:install": "playwright install chromium",
    "start": "node dist/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:redeploy-clean": "tsx scripts/redeploy-clean.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate:cards": "tsx scripts/calibrate-card-limits.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grammyjs/conversations": "^1.2.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.21.1",
    "node-cron": "^4.2.1",
    "openai": "^4.24.1",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "playwright": "^1.49.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
